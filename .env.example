# Server Configuration
PORT=3001
NODE_ENV=development
APP_URL=http://localhost:3001

# Database Configuration (SQLite default for dev, easily switchable to MySQL)
DATABASE_URL="file:./dev.db"
# For MySQL: DATABASE_URL="mysql://root:password@localhost:3306/tripbwi_rotator"

# Default Rotator Settings
